# Required when SPRING_PROFILES_ACTIVE=prod. Replace every example value.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://database-host:3306/addisbuilders_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=addisbuilders_app
DB_PASSWORD=replace-with-a-managed-secret
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=https://app.example.com
APP_UPLOAD_DIR=/var/lib/addisbuilders/uploads
